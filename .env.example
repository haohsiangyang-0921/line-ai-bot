# ==========================================
# LINE Messaging API 設定
# ==========================================
# 於 LINE Developers -> 頻道 -> Basic settings 最下方取得
LINE_CHANNEL_SECRET=請貼上你的_Channel_Secret

# 於 LINE Developers -> 頻道 -> Messaging API 最下方點擊 Issue 取得
LINE_CHANNEL_ACCESS_TOKEN=請貼上你的_Channel_Access_Token

# ==========================================
# Google Gemini AI 設定 (免費 API Key)
# 取得網址: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=請貼上你的_Gemini_API_Key
